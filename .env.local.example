# .env.local
# Voice Transcription Configuration
# Choose one provider and add your API key

# Google Cloud Speech-to-Text
# EXPO_PUBLIC_TRANSCRIPTION_PROVIDER=google
# EXPO_PUBLIC_TRANSCRIPTION_API_KEY=your_google_api_key_here

# OpenAI Whisper
EXPO_PUBLIC_TRANSCRIPTION_PROVIDER=openai
EXPO_PUBLIC_TRANSCRIPTION_API_KEY=your_openai_api_key_here

# AssemblyAI
# EXPO_PUBLIC_TRANSCRIPTION_PROVIDER=assemblyai
# EXPO_PUBLIC_TRANSCRIPTION_API_KEY=your_assemblyai_api_key_here
